# Copy to .env.local (never commit real values).
# Password for /admin
ADMIN_PASSWORD=change-me
# Long random string used to sign the admin session cookie (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string
# Optional: where submissions are stored (default: ./.data)
# DATA_DIR=/var/data/blueprint
